    "darkGreen": "#14110d",
    "darkGreenTint1": "#2a241d",
    "darkGreenTint2": "#443b30",
    "white": "#f2efe6",
    "cream": "#eae6da",
    "greenLight": "#e4dfd2",
    "grey2": "#c6c0b0",
    "greenOffWhite2": "#a8a294",
    "black": "#0c0a08",
    "orange": "#b23a1f"
  },
  "ASSETS": {
