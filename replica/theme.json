    "googleHref": "https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Inter:wght@400;600&family=Saira+Stencil+One&family=Noto+Sans+SC:wght@700&display=swap"
  },
  "RADIUS": "0px",
  "SECTIONS": { "hero": "white", "marquee": "dark", "track": "dark", "otot": "white", "helmets": "white", "exe": "dark", "collabs": "white", "socials": "dark", "footer": "dark" },
